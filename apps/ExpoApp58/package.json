{
  "name": "@callstack/brownfield-example-expo-app-58",
  "main": "./entry.tsx",
  "version": "1.0.2",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --no-cache",
    "test": "jest --config jest.config.js",
    "prebuild": "expo prebuild",
    "brownfield:prepare:android:ci": "cd .. && node --experimental-strip-types --no-warnings ./scripts/prepare-android-build-gradle-for-ci.ts ExpoApp58",
    "brownfield:package:android": "brownfield package:android --module-name brownfieldlib --variant release --verbose",
    "brownfield:publish:android": "brownfield publish:android --module-name brownfieldlib --verbose",
    "brownfield:package:ios": "brownfield package:ios --scheme BrownfieldLib --configuration Release --use-prebuilt-rn-core --use-prebuilt-expo --verbose",
    "eas:stg": "EXPO_TOKEN=$EAS_TOKEN eas update --channel production --message 'testing 1st stg channel update' --platform ios --environment staging"
  },
  "brownfield": {
    "debug": true,
    "android": {
      "expo": {
        "minifyEnabled": false,
        "extraProguardRules": [
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.BrownfieldStore { *; }",
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.BrownfieldStore$Companion { *; }",
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.User { *; }",
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.SettingsStore { *; }",
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.SettingsStore$Companion { *; }",
          "-keep class com.callstack.rnbrownfield.demo.expoapp58.Theme { *; }",
          "-keep class com.callstack.nativebrownfieldnavigation.UserType { *; }"
        ],
        "missingDimensionStrategies": [
          "type",
          "alpha"
        ]
      }
    }
  },
  "dependencies": {
    "@callstack/brownfield-navigation": "workspace:^",
    "@callstack/brownie": "workspace:^",
    "@callstack/react-native-brownfield": "workspace:^",
    "expo": "58.0.0-preview.1",
    "expo-constants": "~58.0.1",
    "expo-device": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-glass-effect": "~58.0.0",
    "expo-image": "~58.0.1",
    "expo-linking": "~58.0.1",
    "expo-router": "~58.0.2",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.1",
    "expo-updates": "~58.0.3",
    "expo-web-browser": "~58.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0-rc.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@callstack/brownfield-example-shared-tests": "workspace:^",
    "@react-native/jest-preset": "0.88.0-rc.0",
    "@react-native/metro-config": "0.88.0-rc.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.1",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "brownie": {
    "kotlin": "./android/brownfieldlib/src/main/java/com/callstack/rnbrownfield/demo/expoapp58/Generated/",
    "kotlinPackageName": "com.callstack.rnbrownfield.demo.expoapp58"
  },
  "private": true
}
